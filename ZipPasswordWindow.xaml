<ui:FluentWindow
    x:Class="SecureFolderLocker.ZipPasswordWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Secure ZIP Password"
    Width="440"
    Height="430"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Grid.Row="0" ShowMaximize="False" ShowMinimize="False" ShowClose="True" />
    <Grid Grid.Row="1" Margin="28,8,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Width="72" Height="72" Margin="0,0,0,16" Padding="8" Background="White" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="14">
            <Image Source="/LogoMark.png" Stretch="Uniform" />
        </Border>
        <TextBlock Grid.Row="1" FontSize="22" FontWeight="SemiBold" Text="Create secure ZIP" TextAlignment="Center" />
        <TextBlock Grid.Row="2" Margin="0,8,0,18" Opacity="0.75" Text="This is a separate ZIP password. Share it with the recipient." TextAlignment="Center" TextWrapping="Wrap" />
        <ui:PasswordBox x:Name="PasswordInput" Grid.Row="3" PasswordChanged="PasswordInput_OnPasswordChanged" />
        <StackPanel Grid.Row="4" Margin="0,20,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <ui:Button Margin="0,0,8,0" Click="CancelButton_OnClick" Content="Cancel" />
            <ui:Button Click="ExportButton_OnClick" Content="Continue" />
        </StackPanel>
    </Grid>
    </Grid>
</ui:FluentWindow>
