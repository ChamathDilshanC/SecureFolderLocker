<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>SecureFolderLocker.ico</ApplicationIcon>
    <AssemblyName>SecureFolderLocker</AssemblyName>
    <RootNamespace>SecureFolderLocker</RootNamespace>
    <!-- The class library, CLI and tests live in subfolders and build as their own projects. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);src/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Logo.png" />
    <Resource Include="LogoMark.png" />
    <Resource Include="SecureFolderLocker.ico" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\SecureFolderLocker.Core\SecureFolderLocker.Core.csproj" />
  </ItemGroup>

</Project>
